{
  "name": "krow-cli",
  "version": "0.3.20",
  "description": "A document-driven workflow for coding agents",
  "type": "module",
  "bin": {
    "krow": "dist/cli.js",
    "krow-cli": "dist/cli.js"
  },
  "files": [
    "docs",
    "dist",
    "install",
    "src/infrastructure/templates"
  ],
  "scripts": {
    "dev": "tsx src/inbound-adapters/cli/main.ts",
    "build": "tsup --entry.cli src/inbound-adapters/cli/main.ts --format esm --dts --clean",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "agent",
    "workflow",
    "cli",
    "coding",
    "codex",
    "claude",
    "gemini"
  ],
  "author": "eatnug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eatnug/krow.git"
  },
  "bugs": {
    "url": "https://github.com/eatnug/krow/issues"
  },
  "homepage": "https://github.com/eatnug/krow#readme",
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
