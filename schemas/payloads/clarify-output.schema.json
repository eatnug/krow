{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krow/payloads/clarify-output",
  "type": "object",
  "additionalProperties": false,
  "required": ["ready", "summary", "assumptions", "evidence", "acceptanceCriteria", "decisions"],
  "properties": {
    "ready": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1 },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verifyFocus": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "options"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "context": { "type": "string" },
          "kind": { "type": "string", "enum": ["clarify", "approval"] },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["prd", "plan", "language", "scope"] },
              "ref": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
