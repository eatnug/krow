{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krow/state/workflow-state",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "workflowId",
    "mode",
    "description",
    "status",
    "phase",
    "units",
    "currentUnitIndex",
    "captureEnabled",
    "maxVerifyAttempts",
    "verifyAttempts",
    "pendingDecisions",
    "decisionHistory",
    "outputs",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "phase_clarify",
        "clarify_pending",
        "phase_execute",
        "phase_verify",
        "phase_capture",
        "completed",
        "blocked",
        "stopped"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["clarify", "execute", "verify", "capture"]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "currentUnitIndex": { "type": "integer", "minimum": 0 },
    "captureEnabled": { "type": "boolean" },
    "maxVerifyAttempts": { "type": "integer", "minimum": 1 },
    "verifyAttempts": { "type": "integer", "minimum": 0 },
    "pendingDecisions": { "type": "array" },
    "decisionHistory": { "type": "array" },
    "outputs": { "type": "object" },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "lastVerifyIssues": { "type": "array" },
    "blockedReason": { "type": "string" }
  }
}
