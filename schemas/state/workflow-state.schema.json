{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krow/state/workflow-state",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "workflowId",
    "mode",
    "description",
    "status",
    "phase",
    "units",
    "currentUnitIndex",
    "captureEnabled",
    "maxVerifyAttempts",
    "verifyAttempts",
    "pendingDecisions",
    "decisionHistory",
    "outputs",
    "taskRoot",
    "relayRoot",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "graphStrategy": {
      "type": "string",
      "enum": ["single", "serial", "parallel_fanout"]
    },
    "graphNotes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": [
        "phase_clarify",
        "clarify_pending",
        "phase_execute",
        "phase_verify",
        "phase_capture",
        "completed",
        "blocked",
        "stopped"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["clarify", "execute", "verify", "capture"]
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["work", "integration"] },
          "request": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "parallelizable": { "type": "boolean" },
          "ownership": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "estimatedEffort": {
            "type": "string",
            "enum": ["small", "medium", "large"]
          },
          "mergeRequired": { "type": "boolean" },
          "sharedRisks": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "verifyFocus": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "currentUnitIndex": { "type": "integer", "minimum": 0 },
    "captureEnabled": { "type": "boolean" },
    "maxVerifyAttempts": { "type": "integer", "minimum": 1 },
    "verifyAttempts": { "type": "integer", "minimum": 0 },
    "pendingDecisions": { "type": "array" },
    "decisionHistory": { "type": "array" },
    "outputs": { "type": "object" },
    "taskRoot": { "type": "string", "minLength": 1 },
    "relayRoot": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "lastVerifyIssues": { "type": "array" },
    "blockedReason": { "type": "string" }
  }
}
