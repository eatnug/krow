{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krow/signals/gate-response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "gate",
    "workflow_id",
    "options",
    "state_ref",
    "instructions"
  ],
  "properties": {
    "type": { "const": "gate" },
    "gate": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "options"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "context": { "type": "string" },
          "kind": { "type": "string", "enum": ["clarify", "approval"] },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": { "type": "string", "enum": ["prd", "plan", "language", "scope"] },
              "ref": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "state_ref": { "type": "string", "minLength": 1 },
    "workflow_task_index_ref": { "type": "string", "minLength": 1 },
    "task_status_ref": { "type": "string", "minLength": 1 },
    "on_complete": { "type": "object" },
    "instructions": { "type": "string", "minLength": 1 }
  }
}
