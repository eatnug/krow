{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krow/signals/run-response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "workflow_id",
    "phase",
    "prompt_ref",
    "required_schema",
    "state_ref",
    "on_complete",
    "instructions"
  ],
  "properties": {
    "type": { "const": "run" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "enum": ["clarify", "execute", "verify", "capture"] },
    "unit_id": { "type": "string", "minLength": 1 },
    "prompt_ref": { "type": "string", "minLength": 1 },
    "required_schema": { "type": "string", "minLength": 1 },
    "state_ref": { "type": "string", "minLength": 1 },
    "workflow_task_index_ref": { "type": "string", "minLength": 1 },
    "task_packet_ref": { "type": "string", "minLength": 1 },
    "task_context_ref": { "type": "string", "minLength": 1 },
    "task_status_ref": { "type": "string", "minLength": 1 },
    "task_result_ref": { "type": "string", "minLength": 1 },
    "baton_ref": { "type": "string", "minLength": 1 },
    "relay_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "context": { "type": "object" },
    "on_complete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "phase"],
      "properties": {
        "kind": { "const": "phase_output" },
        "phase": { "type": "string", "enum": ["clarify", "execute", "verify", "capture"] }
      }
    },
    "instructions": { "type": "string", "minLength": 1 }
  }
}
