{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krow/signals/done-response",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "workflow_id", "status", "state_ref", "message"],
  "properties": {
    "type": { "const": "done" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "blocked", "stopped"] },
    "state_ref": { "type": "string", "minLength": 1 },
    "workflow_task_index_ref": { "type": "string", "minLength": 1 },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "message": { "type": "string", "minLength": 1 }
  }
}
